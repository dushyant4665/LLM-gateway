# Application
PORT=3000
NODE_ENV=development

# PostgreSQL (used by Prisma)
# For local Node.js development (Option 2), use localhost:
DATABASE_URL="postgresql://postgres:password@localhost:5432/gateway_db"
# For Docker Compose (Option 1), change the host to "db":
# DATABASE_URL="postgresql://postgres:password@db:5432/gateway_db"

# Groq — primary LLM provider
# Get your key at https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"
